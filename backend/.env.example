# Salvex Auction API - Environment Configuration Example
# Copy this file to .env and configure appropriate values for your environment.
# NEVER put real passwords, keys or database addresses in this example file; it is committed to Git.
# The real .env is ignored by Git.
#
# SAFE BY DEFAULT: if APP_ENV is missing, the API assumes "production" and refuses to start unless the
# production requirements marked [PROD] below are met. Local development sets APP_ENV=development.

# development | test | staging | production   (staging is held to the production rules)
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

# [PROD] A long random value, at least 32 characters, never shared, never reused between environments.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=change_this_to_a_secure_random_secret_key_at_least_32_chars

# Database Configuration (PostgreSQL Required)
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<database_name>
# For a hosted database add the SSL option at the end, e.g. ?sslmode=require (the API and Alembic each
# get the spelling their driver needs). Percent-encode special characters in the password.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/salvex_auction

# Optional: keep your local database address here when DATABASE_URL points elsewhere. The automated tests
# use it to find your LOCAL server (they only ever use a local database whose name contains "test").
# LOCAL_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/salvex_auction
# Optional: choose the local test database explicitly (must be local and named with "test").
# TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/salvex_test_db

# [PROD] Explicitly allowed website origins for CORS and cross-site request checks.
# Production: https:// only, no wildcards, no localhost.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------- sessions and cookies
# Absolute session length and idle timeout, in minutes.
# ACCESS_TOKEN_EXPIRE_MINUTES=720
# SESSION_IDLE_TIMEOUT_MINUTES=120
# MAX_SESSIONS_PER_USER=10

# Cookies are Secure (HTTPS only) by default everywhere except development/test.
# [PROD] COOKIE_SECURE must not be false. Leave COOKIE_DOMAIN empty for the safest host-only cookie.
# COOKIE_SECURE=true
# COOKIE_SAMESITE=lax          # lax | strict | none (none requires Secure; use only with a CSRF-aware design)
# COOKIE_DOMAIN=

# ---------------------------------------------------------------- abuse protection
# [PROD] Must be true. The built-in limiter is per process; see docs/AUTHENTICATION.md for multi-instance deployments.
# RATE_LIMIT_ENABLED=true
# How many reverse proxies sit in front of the API whose X-Forwarded-For header can be trusted (0 = none).
# Setting this wrongly lets attackers fake their IP address; set it to exactly the number of proxies you run.
# TRUSTED_PROXY_COUNT=0

# ---------------------------------------------------------------- one-time codes
# OTP_VERIFY_EXPIRE_MINUTES=10
# OTP_RESET_EXPIRE_MINUTES=15
# OTP_MAX_ATTEMPTS=5
# OTP_RESEND_COOLDOWN_SECONDS=60

# ---------------------------------------------------------------- email
# console = developer outbox file (development/test ONLY; codes go to the file, never to the log).
#           Read the latest code with:  python -m app.cli dev-last-code you@example.com
# smtp    = real delivery. [PROD] required, with all four SMTP_* values below.
EMAIL_PROVIDER=console
# DEV_OUTBOX_PATH=.dev_outbox/outbox.jsonl
# SMTP_HOST=
# SMTP_PORT=587                # 587 = STARTTLS, 465 = implicit TLS (certificates are always verified)
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=noreply@your-domain.example
# SMTP_FROM_NAME=Salvex Auction Platform
