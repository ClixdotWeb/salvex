# Rendered by the nginx image at start-up (envsubst replaces ${BACKEND_URL}).

# HSTS (one year) only for requests that arrived over HTTPS at Coolify's proxy; see security-headers.conf.
# No includeSubDomains/preload: other subdomains of the company domain may not have HTTPS.
map $http_x_forwarded_proto $salvex_hsts {
    https   "max-age=31536000";
    default "";
}

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    client_max_body_size 12m;          # KYC documents and photos (API limit is 5 MB per file)

    # Compress text responses (HTML, CSS, JS, JSON, SVG): pages load several times faster.
    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_vary on;
    gzip_proxied any;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml application/xml text/xml;

    # Security headers: see security-headers.conf, included in each website location below.
    # /api gets none from here: the API sends its own headers (no duplicates).

    location ~ ^/(api|docs|openapi\.json) {
        # Look the backend up on EVERY request (Docker's DNS at 127.0.0.11), not once at start-up:
        # a redeployed backend gets a new internal IP, and a cached one gives 502 until nginx restarts.
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $salvex_backend ${BACKEND_URL};
        proxy_pass $salvex_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # Built files have a content hash in their name, so they can be cached for a year.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        include /etc/nginx/snippets/security-headers.conf;
        try_files $uri =404;
    }

    # Images and icons in /public change rarely: cache for a week.
    location ~* \.(png|jpe?g|webp|svg|ico)$ {
        expires 7d;
        add_header Cache-Control "public";
        include /etc/nginx/snippets/security-headers.conf;
        try_files $uri =404;
    }

    # The page itself must never be cached: after a deploy every visitor gets the new version at once.
    location / {
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        include /etc/nginx/snippets/security-headers.conf;
        try_files $uri /index.html;
    }
}
