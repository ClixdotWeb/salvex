# Website (frontend) settings. Copy to .env.local for development. These values are PUBLIC:
# they are built into the website, so never put passwords or keys here.

# Backend address. Leave EMPTY when the website and API share one domain (recommended: nginx/Coolify
# or the Vite dev proxy forward /api to the backend).
VITE_API_BASE_URL=

# Company contact details shown in the navbar, footer and Contact page. Empty values are hidden.
VITE_COMPANY_PHONE=
VITE_COMPANY_WHATSAPP=
VITE_COMPANY_EMAIL=
VITE_COMPANY_ADDRESS=
VITE_COMPANY_CITY=
